 fn numpy_values<'py>(py: Python<'py>, mut values: Vec<f64>) -> Bound<'py, numpy::PyArray1<f64>> {
     // The previous JSON bridge mapped all non-finite floats to NumPy NaN.
     for value in &mut values {
